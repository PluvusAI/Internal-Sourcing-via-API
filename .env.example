# Internal sourcing app — environment variables. NAMES AND PLACEHOLDERS ONLY: never commit values.
# On Replit, set the secrets in the Secrets tool; locally, copy to .env.local / your shell.

# --- Sourcing backend (PluvusAI/pluvus-workflow-prototype) -------------------------------------
# Origin of the deployed workflow backend: https://<host> only — no /api/v1 path (a path is a setup error).
SOURCING_API_BASE_URL=https://<workflow-backend-origin>
# The existing PLU-505 internal key: EXACTLY the same value as SOURCING_INTERNAL_APP_API_KEY on the
# sourcing backend. Not the waitlist's SOURCING_SERVICE_API_KEY. Server-side only, never VITE_*.
SOURCING_INTERNAL_APP_API_KEY=<same value as the backend's SOURCING_INTERNAL_APP_API_KEY>
# Sourcing LIMITS (creators per search, spend, pages, runtime…) are NOT set here. They are the
# backend's SOURCING_INTERNAL_APP_MAX_* settings (PLU-509); the app reads the current maximum from
# the backend. Provider, model, database and Redis credentials never belong in this project.

# --- Sign-in (Clerk) -----------------------------------------------------------------------------
# Publishable key: PUBLIC, read at BUILD time by Vite (rebuild after changing it).
VITE_CLERK_PUBLISHABLE_KEY=pk_<...>
# Secret key of the same Clerk application. Server-side only.
CLERK_SECRET_KEY=<clerk secret key>
# Optional networkless verification key (PEM).
# CLERK_JWT_KEY=
# This app's own https origin(s), comma-separated (e.g. its Replit deployment URL). Required in production.
CLERK_AUTHORIZED_PARTIES=https://<this-app-origin>
# Who may sign in — required, comma-separated approved individual Clerk user IDs.
INTERNAL_APP_ALLOWED_USER_IDS=user_<...>,user_<...>

# --- Optional AI criteria assistant (this app's server, not the workflow backend) -----------------
# Add this secret and restart to enable Suggest criteria. Never prefix it with VITE_.
# OPENROUTER_API_KEY=<openrouter secret key>
# Optional model slug supporting structured outputs. Default: openai/gpt-4.1-mini.
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- Server ----------------------------------------------------------------------------------------
# PORT and HOST come from the platform (Replit sets PORT). Defaults: 5000 / 0.0.0.0.
# PORT=5000
# Number of proxies in front of the app that set X-Forwarded-For (Replit deployments: 1+).
# TRUST_PROXY_HOPS=1

# --- Modes ----------------------------------------------------------------------------------------
# Deployed use: leave both unset (defaults SOURCE_MODE=live, AUTH_MODE=clerk).
# Development only (refused when NODE_ENV=production):
# SOURCE_MODE=mock            # in-memory SAMPLE data instead of the sourcing backend (labelled in the UI)
# AUTH_MODE=dev               # local development sign-in instead of Clerk
# MOCK_MAX_TARGET_COUNT=25    # with SOURCE_MODE=mock: the per-search limit the sample backend reports
