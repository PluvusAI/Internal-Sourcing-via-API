# Internal sourcing app — environment variables. NAMES AND PLACEHOLDERS ONLY: never commit values.
# On Replit, set the secrets in the Secrets tool; locally, copy to .env.local / your shell.

# --- Sourcing backend (PluvusAI/pluvus-workflow-prototype) -------------------------------------
# Origin of the deployed sourcing backend, https, no path.
SOURCING_API_BASE_URL=https://<sourcing-backend-origin>
# NEW (PLU-505): the internal app's own service key. The SAME value is set on the sourcing backend
# as SOURCING_INTERNAL_APP_API_KEY. Not the waitlist's SOURCING_SERVICE_API_KEY. Server-side only.
SOURCING_INTERNAL_APP_API_KEY=<32 random bytes, base64url>

# --- Sign-in (Clerk) -----------------------------------------------------------------------------
# Publishable key: PUBLIC, read at BUILD time by Vite (rebuild after changing it).
VITE_CLERK_PUBLISHABLE_KEY=pk_<...>
# Secret key of the same Clerk application. Server-side only.
CLERK_SECRET_KEY=<clerk secret key>
# Optional networkless verification key (PEM).
# CLERK_JWT_KEY=
# The app's own https origin(s), comma-separated. Required in production.
CLERK_AUTHORIZED_PARTIES=https://<this-app-origin>
# Who may sign in: members of these Clerk organizations (their ACTIVE organization) …
INTERNAL_APP_ALLOWED_ORG_IDS=org_<...>
# … and/or these individual Clerk users. At least one of the two lists is required.
# INTERNAL_APP_ALLOWED_USER_IDS=user_<...>,user_<...>

# --- Server ----------------------------------------------------------------------------------------
# PORT and HOST come from the platform (Replit sets PORT). Defaults: 5000 / 0.0.0.0.
# PORT=5000
# Number of proxies in front of the app that set X-Forwarded-For (Replit deployments: 1+).
# TRUST_PROXY_HOPS=1

# --- Development only (refused when NODE_ENV=production) ---------------------------------------
# SOURCE_MODE=mock   # in-memory SAMPLE data instead of the sourcing backend (labelled in the UI)
# AUTH_MODE=dev      # local development sign-in instead of Clerk
